<!-- The "Updating Chief" popup (PLAN 2026-10-07 §1.4): 380 × 176, drawn by DWM (rounded corners, dark acrylic, shadow),
     the dashboard's dark tokens on top. Colours: text #EDEDEF / #A1A1AA / #85858E, rim rgb(255 255 255 / .10).
     SingleBorderWindow, not None: DWM draws the acrylic, the shadow and the open/close animation only for a window with
     a frame. WindowChrome below removes everything of that frame but those. -->
<Window x:Class="ChiefUpdater.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" Height="176"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize" ShowInTaskbar="True" Topmost="False" ShowActivated="False"
        WindowStartupLocation="Manual" Background="Transparent"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Auto"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" Foreground="#EDEDEF">

  <!-- No caption, no resize border; the glass frame over the whole window is what lets DWM draw the backdrop. -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Window.TaskbarItemInfo>
    <TaskbarItemInfo x:Name="Taskbar" ProgressState="Indeterminate" />
  </Window.TaskbarItemInfo>

  <Window.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#E5484D" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TrackBrush" Color="#232328" />
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <!-- Keyboard focus only (not on click): a 2 px ring in Chief's colour, 2 px outside the button. -->
    <Style x:Key="FocusRing">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Border Margin="-4" CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource AccentBrush}" SnapsToDevicePixels="True" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ButtonBase" TargetType="Button">
      <Setter Property="Height" Value="32" />
      <Setter Property="MinWidth" Value="84" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
              <Grid>
                <Border x:Name="Wash" CornerRadius="5" Background="#FFFFFF" Opacity="0" />
                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Wash" Property="Opacity" Value="0.08" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Wash" Property="Opacity" Value="0.14" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#EDEDEF" />
      <Setter Property="BorderBrush" Value="#29FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </Window.Resources>

  <Border x:Name="Surface" CornerRadius="8" BorderThickness="1" BorderBrush="#1AFFFFFF" Background="#0F0F12">
    <!-- 20 px from the window's edge, the rim included. -->
    <Grid x:Name="Body" Margin="19">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="56" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Image x:Name="Face" Width="56" Height="56" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
             RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Chief">
        <Image.RenderTransform>
          <ScaleTransform x:Name="FaceScale" ScaleX="1" ScaleY="1" />
        </Image.RenderTransform>
      </Image>

      <StackPanel Grid.Column="2" VerticalAlignment="Center">
        <TextBlock x:Name="TitleText" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold"
                   Foreground="#EDEDEF" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="VersionText" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="#A1A1AA" Margin="0,3,0,0" />

        <StackPanel x:Name="ProgressPanel" Margin="0,16,0,0">
          <Grid x:Name="TrackHost" Height="4">
            <ProgressBar x:Name="Bar" Minimum="0" Maximum="100" Value="0" Height="4" AutomationProperties.Name="Update progress">
              <ProgressBar.Template>
                <ControlTemplate TargetType="ProgressBar">
                  <Grid>
                    <Border x:Name="PART_Track" CornerRadius="2" Background="{DynamicResource TrackBrush}" />
                    <Border x:Name="PART_Indicator" CornerRadius="2" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}" />
                  </Grid>
                </ControlTemplate>
              </ProgressBar.Template>
            </ProgressBar>
            <!-- While Windows reports nothing yet: a lighter band of Chief's colour sweeps across the track. -->
            <Canvas x:Name="ShimmerHost" IsHitTestVisible="False" Visibility="Collapsed">
              <Rectangle x:Name="Shimmer" Height="4" Width="96">
                <Rectangle.RenderTransform>
                  <TranslateTransform x:Name="ShimmerShift" X="-96" />
                </Rectangle.RenderTransform>
              </Rectangle>
            </Canvas>
          </Grid>
          <Grid Margin="0,9,0,0">
            <TextBlock x:Name="StepText" Foreground="#A1A1AA" FontSize="12" TextTrimming="CharacterEllipsis"
                       AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Step" />
            <TextBlock x:Name="PercentText" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="#85858E" />
          </Grid>
        </StackPanel>

        <StackPanel x:Name="MessagePanel" Margin="0,10,0,0" Visibility="Collapsed">
          <TextBlock x:Name="MessageText" FontSize="13" Foreground="#EDEDEF" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                     LineHeight="18" LineStackingStrategy="BlockLineHeight" MaxHeight="36" AutomationProperties.LiveSetting="Assertive" />
          <TextBlock x:Name="NoteText" FontSize="12" Foreground="#A1A1AA" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
          <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0" Visibility="Collapsed" />
        </StackPanel>
      </StackPanel>
    </Grid>
  </Border>
</Window>
