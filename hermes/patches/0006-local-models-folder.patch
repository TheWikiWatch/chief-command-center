--- a/hermes_cli/local_runtime/bootstrap.py
+++ b/hermes_cli/local_runtime/bootstrap.py
@@ -54,14 +54,39 @@ def _detect_gpu_vendor() -> str | None:
     return detected if detected in {"nvidia", "amd", "intel"} else None
 
 
+def _configured_models_dir() -> Path | None:
+    """``local_runtime.models_dir`` when set to an absolute folder (``~`` and variables expanded): a
+    20 GB GGUF often belongs on another drive than Hermes's home."""
+    try:
+        from hermes_cli.config import load_config_readonly
+
+        raw = str(((load_config_readonly() or {}).get("local_runtime") or {}).get("models_dir") or "").strip()
+    except Exception:
+        return None
+    if not raw:
+        return None
+    path = Path(os.path.expandvars(os.path.expanduser(raw)))
+    return path if path.is_absolute() else None
+
+
 def models_dir() -> Path:
     """Machine-scoped, deliberately NOT profile-scoped: a 20 GB GGUF is a machine asset, and every
-    profile shares the one managed server that serves it (same rule as runtimes_root())."""
+    profile shares the one managed server that serves it (same rule as runtimes_root()).
+    ``local_runtime.models_dir`` moves it (models, assets and download partials alike)."""
+    configured = _configured_models_dir()
+    if configured is not None:
+        return configured
     from hermes_constants import get_default_hermes_root
 
     return get_default_hermes_root() / "models"
 
 
+def partials_dir() -> Path:
+    """Where a model download keeps its partial files: beside the models, so the finished file is
+    renamed into place on the same drive instead of copied across drives."""
+    return models_dir() / ".partials"
+
+
 def assets_dir() -> Path:
     """Non-model companion files (mmproj projectors, spec-decode drafts). A subdirectory so the
     router's model listing — and staged_models() — never mistakes an asset for a servable model."""
