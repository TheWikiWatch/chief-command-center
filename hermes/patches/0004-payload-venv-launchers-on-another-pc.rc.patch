+
+def _venv_launchers_work(environment: Path) -> bool:
+    """A venv's launchers start the interpreter its pyvenv.cfg names as ``home``; False when that is gone."""
+    try:
+        lines = (environment / "pyvenv.cfg").read_text(encoding="utf-8-sig").splitlines()
+    except OSError:
+        return False
+    for line in lines:
+        key, sep, value = line.partition("=")
+        if sep and key.strip().lower() == "home":
+            return Path(value.strip()).is_dir()
+    return True
+
