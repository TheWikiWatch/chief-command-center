diff --git a/hermes_cli/_fleet_faulthandler.py b/hermes_cli/_fleet_faulthandler.py
new file mode 100644
index 0000000000..c733efae06
--- /dev/null
+++ b/hermes_cli/_fleet_faulthandler.py
@@ -0,0 +1,32 @@
+"""Fleet patch 2026-09-26: native-crash stacks into ``$HERMES_HOME/logs/faulthandler.log``.
+
+Replaces the legacy ``venv\\Lib\\site-packages\\hermes_win_faulthandler.pth`` hook, which the PM layout
+no longer loads (the gateway runs on the store Python; kanban workers run it isolated with ``-I``, which
+also ignores ``PYTHONFAULTHANDLER``). Imported from ``hermes_cli.main`` right after the bootstrap, so it
+covers the gateway, workers and the CLI. Stdlib only; never raises.
+"""
+import faulthandler
+import os
+
+#: Holds the pid of the process whose faulthandler already points at the log. A pid rather than a
+#: flag: children inherit the environment but not the enabled handler.
+MARKER = "HERMES_FAULTHANDLER_ON"
+
+
+def install() -> None:
+    home = os.environ.get("HERMES_HOME")
+    pid = str(os.getpid())
+    if not home or os.environ.get(MARKER) == pid:
+        return
+    try:
+        log_dir = os.path.join(home, "logs")
+        os.makedirs(log_dir, exist_ok=True)
+        fh = open(os.path.join(log_dir, "faulthandler.log"), "a", encoding="utf-8", buffering=1)
+        faulthandler.enable(file=fh, all_threads=True)
+        os.environ[MARKER] = pid
+        fh.write(f"\n--- faulthandler enabled pid={pid} ---\n")
+    except Exception:
+        pass
+
+
+install()
