+def _gateway_start_argv(python_exe: str, profile_arg: str) -> list[str]:
+    """``python -m hermes_cli.main [--profile X] gateway start`` — Windows VBS must use start for breakaway."""
+    argv = [python_exe, "-m", "hermes_cli.main"]
+    if profile_arg:
+        argv.extend(profile_arg.split())
+    argv.extend(["gateway", "start"])
+    return argv
