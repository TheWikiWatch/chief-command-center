+def _dm_dir_path() -> Path:
+    """Directory for DM payload files.
+
+    POSIX: per-uid folder under the shared temp root (``hermes-dm-<uid>``).
+    Windows has no ``getuid`` and ``chmod(0o700)`` is not a privacy control;
+    ``%TEMP%\\hermes-dm`` is also first-creator-wins across sandboxes (Codex,
+    etc.), so an unopenable leftover there takes out every Bot Chat DM. Keep
+    payloads under the calling Hermes home instead.
+    """
+    uid_getter = getattr(os, "getuid", None)
+    uid = uid_getter() if callable(uid_getter) else None
+    if uid is not None:
+        return Path(tempfile.gettempdir()) / f"{_DM_DIR_NAME}-{uid}"
+    home = os.getenv("HERMES_HOME")
+    if home:
+        return Path(home) / "tmp" / _DM_DIR_NAME
+    local = os.getenv("LOCALAPPDATA")
+    if local:
+        return Path(local) / "hermes" / "tmp" / _DM_DIR_NAME
+    return Path(tempfile.gettempdir()) / _DM_DIR_NAME
+
+
 def _dm_dir() -> Path:
     uid_getter = getattr(os, "getuid", None)
     uid = uid_getter() if callable(uid_getter) else None
-    path = Path(tempfile.gettempdir()) / (f"{_DM_DIR_NAME}-{uid}" if uid is not None else _DM_DIR_NAME)
-    path.mkdir(mode=0o700, exist_ok=True)
+    path = _dm_dir_path()
+    path.mkdir(mode=0o700, parents=True, exist_ok=True)
     # Shared POSIX temp roots need a per-user directory. Fail closed if an
     # attacker pre-created the expected path or replaced it with a symlink.
     info = path.lstat()
@@ -350,7 +372,9 @@ def _dm_dir() -> Path:
         raise PermissionError(f"DM temp path is not a directory: {path}")
     if uid is not None and info.st_uid != uid:
         raise PermissionError(f"DM temp directory is owned by another user: {path}")
-    if stat.S_IMODE(info.st_mode) != 0o700:
+    # Windows reports 0o777 and chmod(0o700) is either a no-op or WinError 5
+    # on a directory another identity created. POSIX-only.
+    if uid is not None and stat.S_IMODE(info.st_mode) != 0o700:
         path.chmod(0o700)
     return path
 
