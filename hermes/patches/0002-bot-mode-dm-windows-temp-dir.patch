+@pytest.mark.platforms("windows")
+def test_windows_dm_dir_lives_under_hermes_home_not_shared_temp(tmp_path, monkeypatch):
+    """A poisoned %TEMP%\\hermes-dm must not be the DM payload directory."""
+    poison = tmp_path / bot_mode_dm._DM_DIR_NAME
+    poison.mkdir()
+    (poison / "blocker.txt").write_text("nope", encoding="utf-8")
+    home = tmp_path / "hermes-home"
+    monkeypatch.setattr(bot_mode_dm.tempfile, "gettempdir", lambda: str(tmp_path))
+    monkeypatch.setenv("HERMES_HOME", str(home))
+
+    dm_dir = bot_mode_dm._dm_dir()
+    written = Path(bot_mode_dm._write_dm_file("kickoff"))
+
+    assert dm_dir == home / "tmp" / bot_mode_dm._DM_DIR_NAME
+    assert written.parent == dm_dir
+    assert written.read_text(encoding="utf-8") == "kickoff"
+    assert list(poison.glob("dm-*.txt")) == []
+    written.unlink()
+
+
